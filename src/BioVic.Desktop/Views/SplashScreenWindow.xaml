<Window x:Class="BioVic.Desktop.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BioVic - Cargando" Height="340" Width="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent">
    
    <Border Background="#123A43" CornerRadius="18" BorderBrush="#10A3AF" BorderThickness="2">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
            
            <!-- CONTENEDOR DEL ICONO CON ANIMACIÓN DE LATIDO (PULSO) -->
            <Grid Width="110" Height="110" Margin="0,0,0,15">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Efecto de pulso cardíaco suave y constante -->
                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.09" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.09" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <!-- Tu logotipo / icono BioVic.ico -->
                <Image Source="../BioVic.ico" Width="105" Height="105" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- TÍTULO Y ESTILO CORPORATIVO -->
            <TextBlock Text="BioVic" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Tecnología biomédica" FontSize="12" Foreground="#A9CAD0" HorizontalAlignment="Center" Margin="0,2,0,15"/>
            
            <!-- TEXTO DE ESTADO DINÁMICO -->
            <TextBlock x:Name="StatusText" Text="Iniciando servidores y base de datos..." FontSize="12" Foreground="#C8E5E9" HorizontalAlignment="Center" Margin="0,0,0,18"/>
            
            <!-- BARRA DE PROGRESO FLUIDA -->
            <ProgressBar IsIndeterminate="True" Width="240" Height="4" Background="#1E5460" Foreground="#10A3AF" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>