<Window x:Class="BioVic.Desktop.Views.FailureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registrar falla · BioVic" Width="700" Height="700" WindowStartupLocation="CenterOwner"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Registrar falla técnica" FontSize="24" FontWeight="Bold"/><ScrollViewer Grid.Row="1"><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Fecha del reporte *" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="DateBox"/><TextBlock Text="Reportada por *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReportedByBox"/><TextBlock Text="Servicio" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ServiceBox"/><TextBlock Text="Descripción *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DescriptionBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Impacto" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ImpactBox"/><CheckBox x:Name="StoppedBox" Content="El equipo quedó detenido" Margin="0,15"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Acción inmediata" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ImmediateBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Diagnóstico" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DiagnosisBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Solución o pendiente" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SolutionBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Tiempo fuera de servicio (minutos)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DowntimeBox"/><TextBlock Text="Fecha de cierre" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="ClosedBox"/></StackPanel></Grid></ScrollViewer><Grid Grid.Row="2"><TextBlock x:Name="ErrorText" Foreground="#A52A2A"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"/><Button Content="Guardar falla" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/></StackPanel></Grid></Grid></Window>
