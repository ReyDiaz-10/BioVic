<Window x:Class="BioVic.Desktop.Views.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar mantenimiento · BioVic" Width="650" Height="720" WindowStartupLocation="CenterOwner">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,20"><StackPanel><TextBlock Text="Registrar mantenimiento" FontSize="24" FontWeight="Bold" /><TextBlock Text="El registro es aditivo y quedará asociado permanentemente a la hoja de vida." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="30,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tipo *" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="TypeBox" />
                <TextBlock Text="Número de orden" Style="{StaticResource FieldLabel}" /><TextBox x:Name="OrderBox" />
                <TextBlock Text="Fecha realizada *" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="PerformedPicker" />
                <TextBlock Text="Empresa o persona que realizó *" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PerformedByBox" />
                <TextBlock Text="Responsable" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ResponsibleBox" />
                <TextBlock Text="Costo" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CostBox" />
                <TextBlock Text="Tiempo fuera de servicio (minutos)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DowntimeBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Actividades realizadas *" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ActivitiesBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                <TextBlock Text="Hallazgos" Style="{StaticResource FieldLabel}" /><TextBox x:Name="FindingsBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                <TextBlock Text="Diagnóstico técnico" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DiagnosisBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                <TextBlock Text="Acciones realizadas" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ActionsBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                <TextBlock Text="Repuestos utilizados o requeridos" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SparePartsBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                <TextBlock Text="Pendientes y observaciones" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NotesBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                <TextBlock Text="Resultado *" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ResultBox" />
                <TextBlock Text="Próximo mantenimiento" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="NextPicker" />
                <CheckBox x:Name="ChangeStatusBox" Content="Cambiar estado del equipo según resultado" Margin="0,16,0,6" />
                <ComboBox x:Name="ResultingStatusBox" />
            </StackPanel>
        </Grid></ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,16"><Grid><TextBlock x:Name="ErrorText" Foreground="#BE3A3A" TextWrapping="Wrap" MaxWidth="350" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="CancelButton_Click" /><Button x:Name="SaveButton" Content="Guardar mantenimiento" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" /></StackPanel></Grid></Border>
    </Grid>
</Window>
