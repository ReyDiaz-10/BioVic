<Window x:Class="BioVic.Desktop.Views.EquipmentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hoja de vida · BioVic" Width="1020" Height="750" MinWidth="840" MinHeight="620" WindowStartupLocation="CenterOwner">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#123A43" Padding="28,22">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="58" Height="58" CornerRadius="16" Background="#FFFFFF1A"><TextBlock Text="✚" Foreground="#15323A" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1"><TextBlock Text="BIOVIC · HOJA DE VIDA DEL EQUIPO" Foreground="#9DC5CC" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding Name}" Foreground="White" FontSize="25" FontWeight="Bold" Margin="0,3,0,0" /><TextBlock Foreground="#C1DADF"><Run Text="Código " /><Run Text="{Binding InternalCode}" /><Run Text="  ·  Serial " /><Run Text="{Binding SerialNumber}" /></TextBlock></StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right"><Border CornerRadius="10" Background="#FFFFFF15" Padding="12,7"><TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" Foreground="#15323A" FontWeight="Bold" /></Border><WrapPanel Margin="0,8,0,0"><Button x:Name="DocumentsButton" Content="Documentos" Style="{StaticResource SecondaryButton}" Margin="4" Click="DocumentsButton_Click"/><Button x:Name="AddMaintenanceButton" Content="＋ Mantenimiento" Style="{StaticResource PrimaryButton}" Margin="4" Click="AddMaintenanceButton_Click" /><Button x:Name="AddCalibrationButton" Content="＋ Calibración" Style="{StaticResource PrimaryButton}" Margin="4" Click="AddCalibrationButton_Click" /></WrapPanel></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,18,24,22">
            <TextBlock x:Name="LoadingText" Text="Cargando hoja de vida…" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TabControl x:Name="DetailsTabs" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                <TabItem Header="Resumen">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="4,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel>
                                <TextBlock Text="Identificación" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="Fabricante" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Manufacturer}" />
                                <TextBlock Text="Marca / modelo" Style="{StaticResource FieldLabel}" /><TextBlock><Run Text="{Binding Brand}" /><Run Text=" · " /><Run Text="{Binding Model}" /></TextBlock>
                                <TextBlock Text="Tipo / categoría" Style="{StaticResource FieldLabel}" /><TextBlock><Run Text="{Binding EquipmentType}" /><Run Text=" · " /><Run Text="{Binding Category}" /></TextBlock>
                                <TextBlock Text="Descripción" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel></Border>
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Enlace protegido QR" FontSize="16" FontWeight="Bold" />
                                <TextBlock x:Name="QrLinkText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,10" />
                                <TextBlock x:Name="QrStatusText" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12" />
                                <Button x:Name="CopyQrLinkButton" Content="Copiar enlace" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="CopyQrLinkButton_Click" />
                                <WrapPanel x:Name="QrActionsPanel" Margin="0,8,0,0"><Button x:Name="GenerateQrButton" Content="Generar QR" Style="{StaticResource PrimaryButton}" Click="GenerateQrButton_Click"/><Button x:Name="PrintQrButton" Content="Imprimir QR" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="PrintQrButton_Click"/></WrapPanel>
                                <Button Content="Descargar PDF" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="DownloadPdfButton_Click"/>
                            </StackPanel></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel>
                                <TextBlock Text="Operación" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="Ubicación" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Location}" TextWrapping="Wrap" />
                                <TextBlock Text="Responsable" Style="{StaticResource FieldLabel}" /><TextBlock><Run Text="{Binding ResponsibleName}" /><Run Text=" · " /><Run Text="{Binding ResponsiblePosition}" /></TextBlock>
                                <TextBlock Text="Criticidad" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Criticality, Converter={StaticResource EnumSpanishText}}" />
                                <TextBlock Text="Próximo mantenimiento" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding NextMaintenanceUtc, StringFormat={}{0:dd/MM/yyyy}}" />
                                <TextBlock Text="Próxima calibración" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding NextCalibrationUtc, StringFormat={}{0:dd/MM/yyyy}}" />
                                <TextBlock Text="Observaciones operativas" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding PublicOperationalNotes}" TextWrapping="Wrap" />
                            </StackPanel></Border>
                        </StackPanel>
                    </Grid></ScrollViewer>
                </TabItem>
                <TabItem Header="Mantenimiento">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Maintenances}" Margin="4,18"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding PerformedAtUtc, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="Bold" /><TextBlock Text="{Binding Type, Converter={StaticResource EnumSpanishText}}" Foreground="{StaticResource PrimaryBrush}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Activities}" TextWrapping="Wrap" /><TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"><Run Text="Realizó: " /><Run Text="{Binding PerformedBy}" /></TextBlock></StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Result, Converter={StaticResource EnumSpanishText}}" FontWeight="SemiBold" /><TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="Próximo: " /><Run Text="{Binding NextMaintenanceUtc, StringFormat={}{0:dd/MM/yyyy}}" /></TextBlock></StackPanel>
                        </Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </TabItem>
                <TabItem Header="Calibraciones">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Calibrations}" Margin="4,18"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PerformedAtUtc, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding Laboratory}" /><TextBlock Grid.Column="2" Text="{Binding Result, Converter={StaticResource EnumSpanishText}}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </TabItem>
                <TabItem Header="Historial">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding StatusHistory}" Margin="4,18"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ChangedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontWeight="SemiBold" /><TextBlock Grid.Column="1"><Run Text="{Binding PreviousStatus}" /><Run Text="  →  " /><Run Text="{Binding NewStatus}" /></TextBlock><TextBlock Grid.Column="2" Text="{Binding Reason}" TextWrapping="Wrap" /></Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </TabItem>
                <TabItem Header="Tecnovigilancia">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,18"><TextBlock Text="Fallas técnicas" FontSize="17" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Failures}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,0"><StackPanel><TextBlock FontWeight="Bold"><Run Text="{Binding ReportedAtUtc, StringFormat={}{0:dd/MM/yyyy}}"/><Run Text=" · "/><Run Text="{Binding Description}"/></TextBlock><TextBlock Text="{Binding ImmediateAction, StringFormat=Acción inmediata: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Solution, StringFormat=Solución o pendiente: {0}}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Incidentes" FontSize="17" FontWeight="Bold" Margin="0,18,0,0"/><ItemsControl ItemsSource="{Binding Incidents}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,0"><StackPanel><TextBlock FontWeight="Bold"><Run Text="{Binding OccurredAtUtc, StringFormat={}{0:dd/MM/yyyy}}"/><Run Text=" · "/><Run Text="{Binding EventType}"/></TextBlock><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding ActionsTaken, StringFormat=Acciones: {0}}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Revisión automática">
                    <Grid Margin="8,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="BioVic revisa fechas, estado, datos obligatorios y referencias técnicas mediante reglas locales. Ningún dato se envía a servicios externos." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><Button Grid.Row="1" Content="Revisar equipo" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,12" Click="ReviewButton_Click"/><TextBox x:Name="ReviewAnswerBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid>
                </TabItem>            </TabControl>
        </Grid>
    </Grid>
</Window>
