<Window x:Class="BioVic.Desktop.Views.CalibrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registrar calibración · BioVic" Width="620" Height="650" WindowStartupLocation="CenterOwner"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Registrar calibración" FontSize="24" FontWeight="Bold"/><TextBlock Text="El registro y su trazabilidad quedarán en la hoja de vida." Foreground="{StaticResource MutedBrush}"/></StackPanel><ScrollViewer Grid.Row="1"><StackPanel Margin="0,14"><TextBlock Text="Fecha realizada *" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="PerformedBox"/><TextBlock Text="Laboratorio o profesional *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LaboratoryBox"/><TextBlock Text="Número de certificado" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CertificateBox"/><TextBlock Text="Resultado *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ResultBox"/><TextBlock Text="Trazabilidad metrológica" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TraceabilityBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Observaciones y pendientes" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NotesBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Próxima calibración" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="NextBox"/></StackPanel></ScrollViewer><Grid Grid.Row="2"><TextBlock x:Name="ErrorText" Foreground="#A52A2A" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"/><Button Content="Guardar calibración" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/></StackPanel></Grid></Grid></Window>
