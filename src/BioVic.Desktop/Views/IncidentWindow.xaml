<Window x:Class="BioVic.Desktop.Views.IncidentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registrar incidente · BioVic" Width="700" Height="720" WindowStartupLocation="CenterOwner"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Registrar incidente de tecnovigilancia" FontSize="24" FontWeight="Bold"/><ScrollViewer Grid.Row="1"><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Fecha del evento *" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="DateBox"/><TextBlock Text="Tipo de evento *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TypeBox"/><TextBlock Text="Reportado por *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReportedByBox"/><TextBlock Text="Estado" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="StatusBox"/><TextBlock Text="Descripción *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DescriptionBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Consecuencia" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ConsequenceBox" Height="65" AcceptsReturn="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Acciones realizadas" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ActionsBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox x:Name="ExternalBox" Content="Fue reportado externamente" Margin="0,15,0,0"/><TextBlock Text="Número de reporte externo" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ExternalNumberBox"/><TextBlock Text="Entidad reportada" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EntityBox"/><TextBlock Text="Fecha del reporte externo" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="ExternalDateBox"/><TextBlock Text="Conclusiones o pendientes" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ConclusionsBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel></Grid></ScrollViewer><Grid Grid.Row="2"><TextBlock x:Name="ErrorText" Foreground="#A52A2A"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"/><Button Content="Guardar incidente" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/></StackPanel></Grid></Grid></Window>
