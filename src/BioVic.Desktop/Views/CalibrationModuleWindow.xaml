<local:EquipmentModuleWindowBase x:Class="BioVic.Desktop.Views.CalibrationModuleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BioVic.Desktop.Views" Title="BioVic · Calibraciones" Width="980" Height="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Calibraciones" FontSize="26" FontWeight="Bold"/><TextBlock Text="Registre laboratorio, certificado, resultado, trazabilidad metrológica, observaciones y próxima fecha." Foreground="{StaticResource MutedBrush}"/></StackPanel><DataGrid x:Name="GridControl" Grid.Row="1" Margin="0,18" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Equipo" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Código" Binding="{Binding InternalCode}" Width="*"/><DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*"/><DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="2*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ver historial" Click="Details_Click" Style="{StaticResource SecondaryButton}"/><Button Content="Registrar calibración" Click="Add_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/></StackPanel></Grid>
</local:EquipmentModuleWindowBase>
