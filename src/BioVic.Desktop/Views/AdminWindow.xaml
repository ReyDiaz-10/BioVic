<Window x:Class="BioVic.Desktop.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BioVic · Administrador Maestro" Height="720" Width="1120" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="Panel del Administrador Maestro" FontSize="27" FontWeight="Bold"/><TextBlock Text="Usuarios, permisos, indicadores y trazabilidad completa de BioVic." Foreground="{StaticResource MutedBrush}"/></StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Resumen">
                <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button Content="Actualizar indicadores" Click="RefreshDashboard_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                    <WrapPanel Grid.Row="1" Margin="0,20,0,0">
                        <TextBlock x:Name="DashboardText" FontSize="18" TextWrapping="Wrap" Width="850"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Mi cuenta maestra">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28" Width="520" HorizontalAlignment="Left">
                        <TextBlock Text="Cuenta interna del Administrador Maestro" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Estos datos se usan únicamente para ingresar a BioVic. No modifican tu cuenta de Azure ni tu correo institucional."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>

                        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MasterFirstNameBox"/>
                        <TextBlock Text="Apellidos" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MasterLastNameBox"/>
                        <TextBlock Text="Usuario para ingresar a BioVic" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MasterUsernameBox"/>
                        <TextBlock Text="Correo (opcional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MasterEmailBox"/>

                        <Separator Margin="0,20,0,10"/>
                        <TextBlock Text="Contraseña actual" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="MasterCurrentPasswordBox"/>
                        <TextBlock Text="Nueva contraseña (opcional)" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="MasterNewPasswordBox"/>
                        <TextBlock Text="Confirmar nueva contraseña" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="MasterConfirmPasswordBox"/>
                        <TextBlock Text="Si deseas conservar la contraseña actual, deja vacíos los dos campos de nueva contraseña."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        <TextBlock Text="Una nueva contraseña debe tener mínimo 10 caracteres, mayúscula, minúscula, número y símbolo."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>

                        <Button x:Name="SaveMasterProfileButton" Content="Guardar mi cuenta maestra"
                                Click="SaveMasterProfile_Click" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
                        <TextBlock x:Name="MasterProfileStatusText" Foreground="{StaticResource PrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Usuarios y permisos">
                <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="UsersGrid_SelectionChanged">
                        <DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="2*"/><DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="*"/><DataGridTextColumn Header="Rol" Binding="{Binding Role, Converter={StaticResource EnumSpanishText}}" Width="*"/><DataGridCheckBoxColumn Header="Todas las ubicaciones" Binding="{Binding HasAllLocations}" Width="120"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsEnabled}" Width="70"/><DataGridTextColumn Header="Último ingreso" Binding="{Binding LastLoginAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="1" Margin="18,0,0,0"><StackPanel>
                        <TextBlock Text="Crear usuario" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FirstNameBox"/>
                        <TextBlock Text="Apellidos" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LastNameBox"/>
                        <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UsernameBox"/>
                        <TextBlock Text="Correo" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EmailBox"/>
                        <TextBlock Text="Contraseña temporal" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="PasswordBox"/>
                        <TextBlock Text="Rol" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CreateRoleBox"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumSpanishText}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <CheckBox x:Name="CreateAllLocationsBox" Content="Todas las ubicaciones" Margin="0,12,0,4"/>
                        <TextBlock Text="Ubicaciones que podrá consultar" Style="{StaticResource FieldLabel}"/>
                        <ListBox x:Name="CreateLocationsList" Height="115" BorderBrush="{StaticResource LineBrush}" SelectionMode="Multiple"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="3"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <Button Content="Crear usuario" Click="CreateUser_Click" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"/>
                        <Separator Margin="0,20"/>
                        <TextBlock Text="Usuario seleccionado" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Rol y permisos" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="EditRoleBox"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumSpanishText}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <CheckBox x:Name="EnabledBox" Content="Cuenta habilitada" Margin="0,12,0,0"/>
                        <CheckBox x:Name="EditAllLocationsBox" Content="Todas las ubicaciones" Margin="0,10,0,4"/>
                        <TextBlock Text="Ubicaciones autorizadas" Style="{StaticResource FieldLabel}"/>
                        <ListBox x:Name="EditLocationsList" Height="115" BorderBrush="{StaticResource LineBrush}"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="3"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <Button Content="Guardar permisos" Click="SaveAccess_Click" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
                        <TextBlock Text="Motivo para eliminar" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DeleteReasonBox"/>
                        <Button Content="Eliminar usuario" Click="DeleteUser_Click" Background="#B43A3A" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/>
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Ubicaciones">
                <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"><Button Content="Nueva ubicación" Click="NewLocation_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Editar seleccionada" Click="EditLocation_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/><TextBlock Text="Motivo:" VerticalAlignment="Center" Margin="18,0,6,0"/><TextBox x:Name="LocationDeleteReasonBox" Width="230"/><Button Content="Eliminar seleccionada" Click="DeleteLocation_Click" Background="#B43A3A" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/></StackPanel>
                    <DataGrid x:Name="LocationsGrid" Grid.Row="1" Margin="0,14,0,0" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Institución" Binding="{Binding Institution}" Width="*"/><DataGridTextColumn Header="Sede" Binding="{Binding Site}" Width="*"/><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Ubicación completa" Binding="{Binding DisplayName}" Width="3*"/></DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Bandeja BioVic">
                <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"><Button Content="Actualizar mensajes" Click="RefreshNotifications_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Posponer 1 día" Click="SnoozeOneDay_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/><Button Content="Posponer 7 días" Click="SnoozeSevenDays_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/><Button Content="Marcar atendido" Click="ResolveNotification_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/><Button Content="Abrir / corregir equipo" Click="OpenNotificationEquipment_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/></StackPanel>
                    <DataGrid x:Name="NotificationsGrid" Grid.Row="1" Margin="0,14,0,0" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Prioridad" Binding="{Binding Severity, Converter={StaticResource EnumSpanishText}}" Width="90"/><DataGridTextColumn Header="Tipo" Binding="{Binding NotificationType}" Width="130"/><DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="220"/><DataGridTextColumn Header="Mensaje y recomendación" Binding="{Binding Message}" Width="3*"/><DataGridTextColumn Header="Fecha programada" Binding="{Binding DueAtUtc, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/></DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Recuperación">
                <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Actualizar" Click="RefreshRecovery_Click" Style="{StaticResource SecondaryButton}"/>
                        <TextBlock Text="Los datos nunca se recuperan desde el celular; esta operación queda auditada." Foreground="{StaticResource MutedBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="RecoveryGrid" Grid.Row="1" Margin="0,14,0,14" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding ItemType}" Width="110"/>
                            <DataGridTextColumn Header="Elemento" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Detalles" Binding="{Binding Details}" Width="2*"/>
                            <DataGridTextColumn Header="Eliminado" Binding="{Binding DeletedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Motivo de eliminación" Binding="{Binding DeletionReason}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Motivo de restauración:" VerticalAlignment="Center"/>
                        <TextBox x:Name="RecoveryReasonBox" Grid.Column="1" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="Restaurar seleccionado" Click="RestoreDeletedItem_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                        <TextBlock x:Name="RecoveryStatusText" Grid.Column="3" Margin="16,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Auditoría">
                <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"><Button Content="Actualizar registros" Click="RefreshAudit_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Verificar integridad" Click="VerifyAudit_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/><TextBlock x:Name="AuditStatusText" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    <DataGrid x:Name="AuditGrid" Grid.Row="1" Margin="0,14,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Fecha y hora" Binding="{Binding TimestampLocal}" Width="160"/><DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="110"/><DataGridTextColumn Header="Acción" Binding="{Binding Action, Converter={StaticResource AuditActionText}}" Width="180"/><DataGridTextColumn Header="Descripción / consulta" Binding="{Binding Description}" Width="3*"/><DataGridTextColumn Header="Equipo" Binding="{Binding EquipmentId}" Width="220"/><DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
